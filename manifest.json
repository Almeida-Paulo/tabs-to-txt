{
  "manifest_version": 3,
  "name": "Tabs to txt",
  "version": "2.0.1",
  "description": "Export selected tab URLs to a TXT file and restore saved links as browser tabs.",
  "permissions": ["tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tabs to txt",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
